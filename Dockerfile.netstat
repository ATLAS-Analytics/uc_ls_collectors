FROM python:3.12-slim

LABEL maintainer="Ilija Vukotic <ivukotic@cern.ch>"

# Pick up outstanding OS security patches on top of the base image.
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY netstat_collector.py request_data.json ./

RUN useradd --create-home --shell /usr/sbin/nologin collector
USER collector

ENTRYPOINT ["python", "netstat_collector.py"]
